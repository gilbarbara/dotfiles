#!/usr/bin/env zsh

run_help() {

cat <<EOT


Usage: ./install [options]

  Running without arguments launches an interactive multi-select menu.

Options:
    -h, --help  Print this help text

Modules:
    brew        Install brew packages
    claude      Setup Claude Code
    dotfiles    Symlink dotfiles
    pnpm        Install PNPM global packages
    oh_my_zsh   Install oh-my-zsh
    structure   Create directory structure
    tools       Install shell tools

Documentation can be found at https://github.com/gilbarbara/dotfiles

EOT
}
