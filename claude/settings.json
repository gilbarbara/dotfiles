{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "cleanupPeriodDays": "365",
    "ENABLE_LSP_TOOL": "true",
    "ENABLE_TOOL_SEARCH": "true"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "permissions": {
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git checkout:*)",
      "Read(~/.extra)"
    ],
    "defaultMode": "plan"
  },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "afplay ~/.claude/sounds/stop.mp3"
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "statusLine": {
    "type": "command",
    "command": "~/.claude/statusline.sh"
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@chrome-devtools-plugins": true,
    "code-review@claude-plugins-official": true,
    "commit-commands@claude-plugins-official": true,
    "firebase@firebase": false,
    "frontend-design@claude-plugins-official": true,
    "posthog@claude-plugins-official": true,
    "pr-review-toolkit@claude-plugins-official": true,
    "pyright-lsp@claude-plugins-official": true,
    "typescript-lsp@claude-plugins-official": true,
    "context-bar@claude-code-mods": true,
    "mission-control@claude-code-mods": true,
    "next-steps@claude-code-mods": true
  },
  "extraKnownMarketplaces": {
    "chrome-devtools-plugins": {
      "source": {
        "source": "github",
        "repo": "ChromeDevTools/chrome-devtools-mcp"
      }
    },
    "cloudflare": {
      "source": {
        "source": "github",
        "repo": "cloudflare/skills"
      }
    },
    "firebase": {
      "source": {
        "source": "github",
        "repo": "firebase/agent-skills"
      }
    },
    "claude-code-mods": {
      "source": {
        "source": "github",
        "repo": "hamzafer/claude-code-mods"
      }
    }
  },
  "outputStyle": "Concise",
  "effortLevel": "high",
  "modelSettings": {
    "claude-opus-5": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "skipDangerousModePermissionPrompt": true,
  "remoteControlAtStartup": true,
  "crossSessionInbound": "accept",
  "agentPushNotifEnabled": true,
  "skipAutoPermissionPrompt": true,
  "voiceEnabled": true
}
